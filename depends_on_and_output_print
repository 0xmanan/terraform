provider "aws" {
  region = "ap-south-1"
}
terraform {
  required_version = ">=1.17.0"
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = ">= 6.72.0"
    }
  }
}

data "aws_vpc" "default_vpc" {
  default = true
}

resource "aws_security_group" "common" {
  name = "web-sg"
  dynamic "ingress" {
    for_each = [ "22","80","443" , "8080", "3306"]
    content {
      from_port = ingress.value
      to_port = ingress.value
      protocol = "tcp"
      cidr_blocks = [ "0.0.0.0/0" ]
    }
  }
  egress {
    to_port = 0
    from_port = 0
    protocol = "-1"
    cidr_blocks = [ "0.0.0.0/0" ]
  }
}

resource "aws_instance" "web" {
  ami                    = "ami-0866e0e2b09f899d8"
  instance_type          = "t3.small"
  vpc_security_group_ids = [aws_security_group.common.id]
  key_name               = "manan"
  user_data = templatefile("user_data.sh.tmp",{
    team_lead="Manan",
    surname="Jain",
    members=["Sunil kumar","Deepak sainik","Mradul"]
    }
    )
    user_data_replace_on_change = true
    lifecycle {
      create_before_destroy = true
    }
    tags = {
      "Name"="web"
    }
    depends_on = [ aws_instance.app-server , aws_instance.app-db ]
}


resource "aws_instance" "app-server" {
  ami                    = "ami-0866e0e2b09f899d8"
  instance_type          = "t3.micro"
  vpc_security_group_ids = [aws_security_group.common.id]
  key_name               = "manan"
  
    user_data_replace_on_change = true
    lifecycle {
      create_before_destroy = true
    }
    tags = {
      "Name"="app-server"
    }
    depends_on = [  aws_instance.app-db ]
}

resource "aws_instance" "app-db" {
  ami                    = "ami-0866e0e2b09f899d8"
  instance_type          = "t3.micro"
  vpc_security_group_ids = [aws_security_group.common.id]
  key_name               = "manan"
    user_data_replace_on_change = true
    lifecycle {
      create_before_destroy = true
    }
    tags = {
      "Name"="app-db"
    }
}

#---------------------------------------------------------------------------------------------------------------------------

output "common_securitygroup_id" {
  description = "Security group id"
  value = aws_security_group.common.id
}

output "Instances_private_ip_print" {
  description = "print ip"
  value = [ 
    aws_instance.app-server.private_ip,
    aws_instance.app-db.private_ip,
    aws_instance.web.private_ip]
}
