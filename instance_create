provider "aws" {
  region = "ap-south-1"
}
resource "aws_instance" "Test" {
    ami = "ami-05fbd65e334e88c16"
    instance_type = "t3.small"
    vpc_security_group_ids = [aws_security_group.allow_ssh.id]
    tags = {
        Name = "Hello world"
        Env = "Test"
    }
    key_name = "manan"

}

resource "aws_security_group" "allow_ssh" {
  name = "allow_ssh"    
  description = "all ssh login"
  vpc_id =  "vpc-0cdf8f3d57c79d0bd"
  ingress  {
    description = "port 22"
    from_port=22
    to_port=22
    protocol="tcp"
    cidr_blocks=["0.0.0.0/0"]
  }
  egress  {
    description="outbound rules"
    from_port=0
    to_port=0
    protocol="-1"
    cidr_blocks=["0.0.0.0/0"]
  }
  tags = {
    "Name" = "allow_tls"
  }
}
