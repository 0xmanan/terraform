provider "aws" {
  region = "ap-south-1"
}
terraform {
  required_version = ">=1.17.0"
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = ">= 6.72.0"
    }
  }
}

data "aws_vpc" "default_vpc" {
  default = true
}

resource "aws_security_group" "aws_security_group" {
  name = "web-sg"
  ingress {
    to_port = 80
    from_port = 80
    protocol = "tcp"
    cidr_blocks = [ "0.0.0.0/0" ]
  }
  egress {
    to_port = 0
    from_port = 0
    protocol = "-1"
    cidr_blocks = [ "0.0.0.0/0" ]
  }
}

resource "aws_instance" "web" {
  ami                    = "ami-0866e0e2b09f899d8"
  instance_type          = "t3.small"
  vpc_security_group_ids = [aws_security_group.aws_security_group.id]
  key_name               = "manan"
  user_data = templatefile("user_data.sh.tmp",{
    team_lead="manan",
    surname="jain",
    members=["Sunil kumar","Deepak sainik","Mradul"]
    }
    )
    user_data_replace_on_change = true
    lifecycle {
      create_before_destroy = true
    }
    tags = {
      "Name"="web"
    }
}
resource "aws_eip" "aws_eip" {
  domain = "vpc"
  instance = aws_instance.web.id
  tags = {
    Name="web"
  }
}
