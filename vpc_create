provider "aws" {
  region = "ap-south-1"
}

terraform {
  required_version = ">=1.17.0"
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = ">= 6.72.0"
    }
  }
}

resource "aws_vpc" "myvpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    name="myvpc",
    Env="test"
  }
}

resource "aws_subnet" "public" {
  vpc_id = aws_vpc.myvpc.id
  cidr_block = "10.0.0.0/18"
  tags = {
    name="pub"
    env="test"
  }
}

resource "aws_subnet" "private-1" {
  vpc_id = aws_vpc.myvpc.id
  cidr_block = "10.0.64.0/18"
  tags = {
    name="private_subnet-1"
    env="test"
  }
}

resource "aws_subnet" "private-2" {
  vpc_id = aws_vpc.myvpc.id
  cidr_block = "10.0.128.0/18"
  tags = {
    name="private_subnet-2"
    env="test"
  }
}


#step 4  create igw

resource "aws_internet_gateway" "my_igw" {
  vpc_id = aws_vpc.myvpc.id
  tags = {
    name="my-igw"
    enc="test"
  }
}

resource "aws_eip" "nat_ip" {
  domain  ="vpc"
}

resource "aws_nat_gateway" "my_nat" {
  allocation_id = aws_eip.nat_ip.id
  subnet_id = aws_subnet.public.id
  tags={
    name="my-nat"
    env="test"
  } 
}

resource "aws_route_table" "my_rt_public" {
  vpc_id = aws_vpc.myvpc.id
  route  {
    cidr_block="0.0.0.0/0"
    gateway_id=aws_internet_gateway.my_igw.id
  }
  tags = {
    name="public_rt"
    env="test"
  }
}


resource "aws_route_table" "my_rt_private" {
  vpc_id = aws_vpc.myvpc.id
  route  {
    cidr_block="0.0.0.0/0"
    nat_gateway_id=aws_nat_gateway.my_nat.id
  }
  tags = {
    name="private_rt"
    env="test"
  }
}


resource "aws_route_table_association" "private_rt_assoc" {
  for_each = {
    private_1 = aws_subnet.private-1.id
    private_2 = aws_subnet.private-2.id
  }

  route_table_id = aws_route_table.my_rt_private.id
  subnet_id      = each.value
}



resource "aws_route_table_association" "public_rt_assoc" {
  route_table_id = aws_route_table.my_rt_public.id
  subnet_id =aws_subnet.public.id
}  
