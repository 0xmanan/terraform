provider "aws" {
  region = "ap-south-1"
}
terraform {
  required_version = ">=1.17.0"
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = ">= 6.72.0"
    }
  }
}

data "aws_vpc" "default_vpc" {
  default = true
}
 # Creating Database

resource "aws_db_instance" "prod" {
    allocated_storage = 10
    instance_class = "db.t3.micro"
    db_name = "mydb"
    engine = "mysql"
    engine_version = "8.4.8"
    username = "manan"
    password = aws_ssm_parameter.rds_password.value
    parameter_group_name = "default.mysql8.4"
    skip_final_snapshot = true
    apply_immediately = true
      
}

# random password generate

resource "random_password" "main" {
  length = 10
  special = true
  override_special = "()!@_#"
}

# Output store
 

output "rds_password" {
  value = random_password.main.result
  sensitive = true
}

output "rds_username" {
  value = aws_db_instance.prod.username
}

output "rds_port" {
  value = aws_db_instance.prod.port
}

output "rds_address" {
  value = aws_db_instance.prod.address
}

# store it to ssm parameter

resource "aws_ssm_parameter" "rds_password" {
  name="/prod/prod-mysql/password"
  description = "password storing"
  type = "SecureString"  # encrryption will be performed by KMS "DEFAULT KEY WILL BE USED IF KEY NOT SPECIFIED"
  value = random_password.main.result
}
