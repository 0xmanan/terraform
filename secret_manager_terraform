provider "aws" {
  region = "ap-south-1"
}
terraform {
  required_version = ">=1.17.0"
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = ">= 6.72.0"
    }
  }
}

data "aws_vpc" "default_vpc" {
  default = true
}
 # Creating Database

resource "aws_db_instance" "prod" {
    allocated_storage = 10
    instance_class = "db.t3.micro"
    db_name = "mydb"
    engine = "mysql"
    engine_version = "8.4.8"
    username = "manan"
    password = data.aws_secretsmanager_secret_version.rds_password.secret_string
    parameter_group_name = "default.mysql8.4"
    skip_final_snapshot = true
    apply_immediately = true
      
}

# random password generate

resource "random_password" "main" {
  length = 10
  special = true
  override_special = "()!@_#"
}

#aws secret manager
resource "aws_secretsmanager_secret" "rds_password" {    # ye container hai 
  name="/prod/prod-mysql/password"
  recovery_window_in_days = 0

}


resource "aws_secretsmanager_secret_version" "rds_password" {
  secret_id = aws_secretsmanager_secret.rds_password.id
  secret_string = random_password.main.result
}

data "aws_secretsmanager_secret_version" "rds_password" {
  secret_id = aws_secretsmanager_secret.rds_password.id
  depends_on = [ aws_secretsmanager_secret_version.rds_password ]
}

# Output store
 

output "rds_password" {
  value = random_password.main.result
  sensitive = true
}

output "rds_username" {
  value = aws_db_instance.prod.username
}

output "rds_port" {
  value = aws_db_instance.prod.port
}

output "rds_address" {
  value = aws_db_instance.prod.address
}
